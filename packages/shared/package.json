{
  "name": "@portfolio/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schemas/*": {
      "@portfolio/source": "./src/schemas/*.ts",
      "types": "./dist/schemas/*.d.ts",
      "default": "./dist/schemas/*.js"
    },
    "./errors": {
      "@portfolio/source": "./src/errors/codes.ts",
      "types": "./dist/errors/codes.d.ts",
      "default": "./dist/errors/codes.js"
    },
    "./messages/es": {
      "@portfolio/source": "./src/messages/es.ts",
      "types": "./dist/messages/es.d.ts",
      "default": "./dist/messages/es.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
