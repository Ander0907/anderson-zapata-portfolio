# Copy to .env (git-ignored) and adjust. Placeholders only: never commit real values.

# Local PostgreSQL (docker compose)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=portfolio
# Host port for the local container. Change it if 5432 is taken, and use the same port in DATABASE_URL and DATABASE_URL_UNPOOLED.
POSTGRES_HOST_PORT=5432

# Application connection (pooled in Neon; the same local server here)
DATABASE_URL=postgresql://portfolio:change-me-locally@localhost:5432/portfolio
# Direct connection used only by `prisma migrate deploy` (ADR-019)
DATABASE_URL_UNPOOLED=postgresql://portfolio:change-me-locally@localhost:5432/portfolio

# API runtime; apps/api validates these at startup.
# Required, with no default: `pnpm start` reads it from .env or the platform environment and fails
# without it. Set it to production on every deployed service. development, test or production.
NODE_ENV=development
PORT=8080
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Google Cloud project, used to link logs to traces. Leave empty locally.
GCP_PROJECT_ID=
# Comma-separated exact origins, no spaces. Leave empty for the same-origin model: CORS stays off.
CORS_ALLOWED_ORIGINS=
# Requests allowed per client IP (IPv6: per /64), per route, in each window.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
