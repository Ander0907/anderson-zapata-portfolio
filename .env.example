# Copy to .env (git-ignored) and adjust. Placeholders only: never commit real values.

# Local PostgreSQL (docker compose)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=portfolio
# Host port for the local container. Change it if 5432 is taken, and use the same port in DATABASE_URL and DATABASE_URL_UNPOOLED.
POSTGRES_HOST_PORT=5432

# Application connection (pooled in Neon; the same local server here)
DATABASE_URL=postgresql://portfolio:change-me-locally@localhost:5432/portfolio
# Direct connection used only by `prisma migrate deploy` (ADR-019)
DATABASE_URL_UNPOOLED=postgresql://portfolio:change-me-locally@localhost:5432/portfolio
